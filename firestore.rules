rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // OPTIONAL: allow leaderboard or public read access
    match /leaderboard/{docId} {
      allow read: if true;
    }
  }
}
